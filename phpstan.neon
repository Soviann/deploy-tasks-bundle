includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 9
    tmpDir: var/cache/phpstan
    paths:
        - src
        - tests
    ignoreErrors:
        # DBAL 3.x / 4.0–4.2 schema path: only runs when Table::editor() is missing,
        # so the APIs DBAL 4.5 deprecates are never called on the version analysed here.
        -
            identifier: method.deprecated
            path: src/Storage/Dbal/DbalStorage.php
            message: '#^Call to deprecated method (addColumn|addOption|setPrimaryKey)\(\) of class Doctrine\\DBAL\\Schema\\Table#'
        -
            identifier: function.alreadyNarrowedType
            path: src/Storage/Dbal/DbalStorage.php
            message: "#^Call to function method_exists\\(\\) with 'Doctrine\\\\\\\\DBAL\\\\\\\\Schema\\\\\\\\Table' and 'editor' will always evaluate to true\\.$#"
        # DBAL 3 skip guard: constant-false against the analysed DBAL 4.
        -
            identifier: function.alreadyNarrowedType
            path: tests/Unit/Storage/DbalStorageDeprecationTest.php
        # Version gate for Symfony 5.4 LTS: constant-true against the analysed Symfony line.
        -
            identifier: greaterOrEqual.alwaysTrue
            path: tests/Support/FrameworkTestConfig.php
